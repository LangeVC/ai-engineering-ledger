{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ael.invalid/schema/core/0.1/measurement.schema.json",
  "title": "AEL measurement v0.1 (unit/aggregation validated against units.catalog.json)",
  "type": "object",
  "required": ["schema_version", "measurement_id", "event_id", "metric", "value", "unit", "aggregation", "source", "source_account_id", "provenance", "evidence_ids", "collector_version", "mapping_version", "revision"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "measurement_id": {"$ref": "common.schema.json#/$defs/ulid"},
    "event_id": {"$ref": "common.schema.json#/$defs/ulid"},
    "metric": {"enum": ["requests","input_tokens","output_tokens","reasoning_tokens","cache_read_tokens","cache_write_tokens","cache_hit_tokens","cache_miss_tokens","total_tokens","cost","credit_balance","credits_consumed","subscription_price","quota_used","quota_remaining","quota_limit","quota_percent_used"]},
    "value": {"description": "Finite exact number: integer or decimal string. JSON floats/NaN/Infinity are rejected.", "anyOf": [{"type": "integer"}, {"$ref": "common.schema.json#/$defs/decimal_string"}]},
    "unit": {"enum": ["request", "token", "credit", "percent", "usd", "eur", "cny"]},
    "aggregation": {"enum": ["absolute", "delta", "interval_total", "gauge"]},
    "source": {"$ref": "common.schema.json#/$defs/alias"},
    "source_account_id": {"$ref": "common.schema.json#/$defs/alias"},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "window": {"$ref": "event.schema.json#/$defs/window"},
    "dimensions": {"type": "object"},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ev_[0-9A-HJKMNP-TV-Z]{26}$"}},
    "collector_version": {"type": "string", "minLength": 1},
    "mapping_version": {"$ref": "common.schema.json#/$defs/semver"},
    "revision": {"$ref": "revision.schema.json"}
  }
}
