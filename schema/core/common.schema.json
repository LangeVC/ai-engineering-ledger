{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ael.invalid/schema/core/0.1/common.schema.json",
  "title": "AEL common definitions v0.1",
  "$defs": {
    "ulid": {"type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"},
    "alias": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"description": "RFC 3339 with mandatory explicit offset (or Z); no local/naive times.", "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "decimal_string": {"description": "Exact decimal; floats are forbidden for money/tokens (DQ04).", "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "provenance": {
      "type": "object",
      "required": ["class", "method", "confidence", "confidence_reason", "validation_status"],
      "additionalProperties": false,
      "properties": {
        "class": {"enum": ["P0", "P1", "P2", "P3", "P4", "P5"]},
        "method": {"enum": ["api", "cli", "import", "otlp", "local", "manual", "derived", "estimate"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_reason": {"type": "string", "minLength": 1},
        "validation_status": {"enum": ["unvalidated", "format_checked", "semantically_checked", "conflicted", "invalid"]},
        "reconciled_at": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
