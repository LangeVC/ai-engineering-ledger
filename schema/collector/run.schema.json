{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ael.local/schema/collector/run.schema.json",
  "title": "Collection run: accounts, coverage, pagination, process capture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "trigger",
    "started_at",
    "finished_at",
    "status",
    "exit_status",
    "routing_subset",
    "account_runs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "enum": [
        "manual",
        "scheduler"
      ]
    },
    "started_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "status": {
      "enum": [
        "success",
        "partial_failure",
        "failure"
      ]
    },
    "exit_status": {
      "enum": [
        0,
        3,
        1
      ],
      "description": "Process exit code per ADR-0002: 0=success, 3=partial_failure, 1=failure"
    },
    "routing_subset": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "explicit; empty array = no routing filter"
    },
    "account_runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/account_run"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "properties": {
          "exit_status": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "partial_failure"
          }
        }
      },
      "then": {
        "properties": {
          "exit_status": {
            "const": 3
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failure"
          }
        }
      },
      "then": {
        "properties": {
          "exit_status": {
            "const": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pages_fetched",
        "complete",
        "truncated",
        "next_cursor"
      ],
      "properties": {
        "pages_fetched": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "truncated": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_committed_cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "truncated": {
                "const": false
              },
              "next_cursor": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "delivered",
        "confirmed",
        "confirmation"
      ],
      "properties": {
        "requested": {
          "$ref": "common.schema.json#/$defs/period"
        },
        "delivered": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/period"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmed": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/period"
            },
            {
              "type": "null"
            }
          ]
        },
        "confirmation": {
          "enum": [
            "complete",
            "partial",
            "unconfirmed"
          ]
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "confirmation": {
                "const": "complete"
              }
            }
          },
          "then": {
            "required": [
              "pagination",
              "delivered"
            ],
            "properties": {
              "confirmed": {
                "$ref": "common.schema.json#/$defs/period"
              },
              "delivered": {
                "$ref": "common.schema.json#/$defs/period"
              },
              "pagination": {
                "properties": {
                  "complete": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "confirmation": {
                "const": "unconfirmed"
              }
            }
          },
          "then": {
            "properties": {
              "confirmed": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "process_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "exit_code",
        "signal",
        "stdout_sha256",
        "stderr_sha256",
        "stdout_truncated",
        "stderr_truncated",
        "started_at",
        "finished_at",
        "profile_id"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        },
        "stdout_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "stderr_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "stdout_truncated": {
          "type": "boolean"
        },
        "stderr_truncated": {
          "type": "boolean"
        },
        "started_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "finished_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "profile_id": {
          "$ref": "common.schema.json#/$defs/alias"
        }
      }
    },
    "account_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_alias",
        "profile_id",
        "source",
        "product_domain",
        "capability",
        "status",
        "observed_at",
        "coverage",
        "errors"
      ],
      "properties": {
        "account_alias": {
          "$ref": "common.schema.json#/$defs/alias"
        },
        "profile_id": {
          "$ref": "common.schema.json#/$defs/alias"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/source"
        },
        "product_domain": {
          "$ref": "common.schema.json#/$defs/product_domain"
        },
        "capability": {
          "$ref": "common.schema.json#/$defs/capability_name"
        },
        "status": {
          "enum": [
            "success",
            "failure",
            "skipped_unsupported",
            "skipped_unverified",
            "skipped_unauthorized"
          ]
        },
        "observed_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "error.schema.json"
          }
        },
        "process": {
          "$ref": "#/$defs/process_capture"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failure"
              }
            }
          },
          "then": {
            "properties": {
              "errors": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}