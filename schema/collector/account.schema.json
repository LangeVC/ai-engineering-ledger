{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ael.local/schema/collector/account.schema.json",
  "title": "Account with isolated profile and capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "alias", "profile_id", "product_domains", "capabilities", "health"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source": {"$ref": "common.schema.json#/$defs/source"},
    "alias": {"$ref": "common.schema.json#/$defs/alias"},
    "profile_id": {"$ref": "common.schema.json#/$defs/alias"},
    "secret_ref": {"type": "string", "pattern": "^(env|keychain|file):.+"},
    "product_domains": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/product_domain"}},
    "capabilities": {"type": "array", "items": {"$ref": "capability.schema.json"}},
    "health": {"enum": ["ready", "degraded", "unauthorized", "unverified", "unsupported"]},
    "health_checked_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
