{
  "source": "deepseek",
  "account_alias": "deepseek-main",
  "format": "csv",
  "has_historical_api": false,
  "documentation_references": [
    "https://api-docs.deepseek.com/quick_start/token_usage/",
    "https://api-docs.deepseek.com/guides/kv_cache/"
  ],
  "collector_status": "unverified",
  "import_status": "supported",
  "column_mapping": {
    "date": {
      "target_metric": "period.start",
      "target_type": "iso8601_date",
      "required": true,
      "description": "Observation date in UTC"
    },
    "model": {
      "target_metric": "dimensions.model",
      "target_type": "string",
      "required": true,
      "description": "Model identifier, e.g. deepseek-chat or deepseek-reasoner"
    },
    "requests": {
      "target_metric": "requests",
      "unit": "request",
      "aggregation": "sum",
      "target_type": "integer",
      "required": false,
      "default": 1
    },
    "prompt_tokens": {
      "target_metric": "input_tokens",
      "unit": "token",
      "aggregation": "sum",
      "target_type": "integer",
      "required": true,
      "description": "Total prompt tokens (prompt_cache_hit_tokens + prompt_cache_miss_tokens)"
    },
    "prompt_cache_hit_tokens": {
      "target_metric": "cache_hit_tokens",
      "unit": "token",
      "aggregation": "sum",
      "target_type": "integer",
      "required": true,
      "description": "Context caching hit tokens billed at reduced rate"
    },
    "prompt_cache_miss_tokens": {
      "target_metric": "cache_miss_tokens",
      "unit": "token",
      "aggregation": "sum",
      "target_type": "integer",
      "required": true,
      "description": "Context caching miss tokens billed at standard rate"
    },
    "completion_tokens": {
      "target_metric": "output_tokens",
      "unit": "token",
      "aggregation": "sum",
      "target_type": "integer",
      "required": true,
      "description": "Output tokens generated by model"
    },
    "reasoning_tokens": {
      "target_metric": "reasoning_tokens",
      "unit": "token",
      "aggregation": "sum",
      "target_type": "integer",
      "required": false,
      "default": 0,
      "description": "Chain-of-thought tokens for reasoning models"
    },
    "cost": {
      "target_metric": "cost",
      "unit": "USD",
      "aggregation": "sum",
      "target_type": "decimal",
      "required": true,
      "description": "Total billed amount in USD"
    }
  },
  "invariants": [
    "prompt_tokens == prompt_cache_hit_tokens + prompt_cache_miss_tokens",
    "prompt_cache_hit_tokens >= 0",
    "prompt_cache_miss_tokens >= 0",
    "completion_tokens >= 0",
    "reasoning_tokens <= completion_tokens"
  ]
}
