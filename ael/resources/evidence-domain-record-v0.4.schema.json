{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://langevc.github.io/ael/schema/living/evidence-domain-record-0.4.json",
  "title": "AEL evidence domain record 0.4",
  "type": "object",
  "required": [
    "schema_version",
    "record_id",
    "domain",
    "interval",
    "confidence",
    "coverage",
    "provenance",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "0.4"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "process",
        "infrastructure",
        "capability"
      ]
    },
    "interval": {
      "type": "object",
      "required": [
        "start",
        "end_exclusive"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end_exclusive": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "coverage": {
      "enum": [
        "complete",
        "partial",
        "unknown",
        "unsupported",
        "unverified",
        "unavailable"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "method",
        "evidence_ids"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

